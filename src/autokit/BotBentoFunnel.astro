<script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/ScrollTrigger.min.js"></script>
<script>
/* ---- theme toggle (init ran in <head>) ---- */
(function(){
  const btn=document.getElementById('themeBtn'),root=document.documentElement;
  sync();
  btn.addEventListener('click',()=>{
    const t=root.dataset.theme==='dark'?'light':'dark';
    root.dataset.theme=t;
    try{localStorage.setItem('akl-theme',t)}catch(e){}
    sync();
  });
  function sync(){
    const dark=root.dataset.theme==='dark';
    btn.textContent=dark?'☀️':'🌙';
    btn.setAttribute('aria-pressed',String(dark));
    btn.setAttribute('aria-label',dark?'Switch to light theme':'Switch to dark theme');
  }
})();

/* ---- Motion strategy (3 layers): CSS media block kills keyframes/transitions;
   GSAP created only inside gsap.matchMedia(no-preference); typewriter prints statically under reduce. ---- */

/* ---- scroll reveal (CSS fallback when GSAP absent) ---- */
(function(){
  if(matchMedia('(prefers-reduced-motion: reduce)').matches){
    document.querySelectorAll('.rv').forEach(el=>el.classList.add('in'));return;
  }
  if(window.gsap)return;
  const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
  document.querySelectorAll('.rv').forEach(el=>io.observe(el));
})();

/* ---- typewriter: single-owner, grapheme-safe, 2 passes then hold ---- */
(function(){
  const body=document.getElementById('termBody');
  const FULL='<span class="u">&gt; </span>run card-04 customer-reply-drafter<br><span class="a">✓ role loaded: support drafter<br>✓ inputs: refund email + policy notes<br></span><span class="hl">draft: </span>ready — 2 facts flagged for review<br><br><span class="u">&gt; </span>log run --tracker<br><span class="a">✓ logged: worked, reuse next week<br>✓ next action: send after fact-check</span>';
  if(matchMedia('(prefers-reduced-motion: reduce)').matches){body.innerHTML=FULL;return}
  const script=[
    {t:'> ',c:'u'},{t:'run card-04 customer-reply-drafter\n',c:'',type:true},
    {t:'✓ role loaded: support drafter\n',c:'a',pause:400},
    {t:'✓ inputs: refund email + policy notes\n',c:'a',pause:300},
    {t:'draft: ',c:'hl',pause:500},{t:'ready — 2 facts flagged for review\n\n',c:'',type:true},
    {t:'> ',c:'u',pause:700},{t:'log run --tracker\n',c:'',type:true},
    {t:'✓ logged: worked, reuse next week\n',c:'a',pause:450},
    {t:'✓ next action: send after fact-check\n',c:'a',pause:350},
  ];
  let runId=0,pass=0,timer=null,running=false;
  function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/\n/g,'<br>')}
  function cur(on){const c=body.querySelector('.cursor');if(c)c.remove();if(on)body.insertAdjacentHTML('beforeend','<span class="cursor"></span>')}
  function start(){
    if(running)return;running=true;
    const my=++runId;body.innerHTML='';let i=0;
    (function step(){
      if(my!==runId)return;
      if(i>=script.length){
        pass++;
        if(pass>=2){cur(true);running=false;return}
        timer=setTimeout(()=>{if(my===runId){running=false;start()}},6000);return;
      }
      const s=script[i++];
      timer=setTimeout(()=>{
        if(my!==runId)return;
        if(s.type){
          const chars=[...s.t];let j=0;
          (function ch(){
            if(my!==runId)return;
            cur(false);
            body.insertAdjacentHTML('beforeend',`<span class="${s.c}">${esc(chars[j])}</span>`);
            cur(true);
            if(++j<chars.length)timer=setTimeout(ch,34+((j*7)%40));else step();
          })();
        }else{
          cur(false);
          body.insertAdjacentHTML('beforeend',`<span class="${s.c}">${esc(s.t)}</span>`);
          cur(true);
          step();
        }
      },s.pause||60);
    })();
  }
  function stop(){runId++;clearTimeout(timer);running=false}
  document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();else if(pass<2)start()});
  window.__termStart=start;
  if(!window.gsap)start();
})();

/* ---- GSAP choreography ---- */
(function(){
  if(!window.gsap)return;
  gsap.registerPlugin(ScrollTrigger);
  const mm=gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)',()=>{
    gsap.defaults({duration:.7,ease:'power3.out'});
    const kill=document.createElement('style');
    kill.textContent='.js .rv{transition:none!important;opacity:1;transform:none}';
    document.head.appendChild(kill);
    document.querySelectorAll('.rv').forEach(el=>el.classList.add('in'));

    /* hero entrance */
    const tl=gsap.timeline();
    tl.from('.pill',{y:24,autoAlpha:0,scale:.85,ease:'back.out(1.6)'},.05)
      .from('.hero h1',{y:56,autoAlpha:0,duration:.9,ease:'expo.out'},.15)
      .from('.hero .lead',{y:30,autoAlpha:0},.38)
      .from('.hero-cta .btn',{y:22,autoAlpha:0,scale:.92,stagger:.09,ease:'back.out(1.5)'},.52)
      .from('.hero .micro span',{y:14,autoAlpha:0,stagger:.06,duration:.45},.68)
      .from('.term',{y:70,autoAlpha:0,duration:.9,ease:'expo.out'},.3)
      .from('.bento',{y:-110,autoAlpha:0,duration:.85,ease:'bounce.out'},.75)
      .call(()=>window.__termStart&&window.__termStart(),null,1.1);

    /* counters */
    document.querySelectorAll('.micro b').forEach(b=>{
      const n=parseInt(b.textContent,10);if(isNaN(n))return;
      const o={v:0};
      gsap.to(o,{v:n,duration:1.2,delay:.8,ease:'power2.out',onUpdate:()=>{b.textContent=Math.round(o.v)}});
    });

    /* ghost numerals: slow parallax drift */
    document.querySelectorAll('.sec-num').forEach(el=>{
      gsap.fromTo(el,{yPercent:18},{yPercent:-14,ease:'none',
        scrollTrigger:{trigger:el.parentElement,start:'top bottom',end:'bottom top',scrub:1.2}});
    });

    /* section headers */
    document.querySelectorAll('section .sec-tag, section h2, section .sec-intro').forEach(el=>{
      gsap.from(el,{y:34,autoAlpha:0,duration:.75,scrollTrigger:{trigger:el,start:'top 88%',once:true}});
    });

    /* comparison cards */
    gsap.from('.duo .plat',{y:44,autoAlpha:0,rotation:i=>i?1.2:-1.2,stagger:.12,duration:.8,ease:'back.out(1.3)',
      scrollTrigger:{trigger:'.duo',start:'top 82%',once:true}});

    /* pipeline */
    const pc=document.querySelector('.pipe-card');
    if(pc){
      gsap.timeline({scrollTrigger:{trigger:pc,start:'top 78%',once:true}})
        .from(pc,{y:50,autoAlpha:0,duration:.7,ease:'expo.out'})
        .from('.pipe rect',{scale:.6,autoAlpha:0,transformOrigin:'center',stagger:.14,ease:'back.out(1.8)',duration:.5},.25)
        .from('.pipe text, .pipe .nico',{autoAlpha:0,stagger:.025,duration:.3},.5)
        .from('.pipe .link',{autoAlpha:0,stagger:.12,duration:.4},.45)
        .from('.legend span',{y:12,autoAlpha:0,stagger:.07,duration:.4},'>-.2');
    }
    gsap.from('.tstep',{y:38,autoAlpha:0,stagger:.14,ease:'back.out(1.4)',
      scrollTrigger:{trigger:'.timeline',start:'top 82%',once:true}});
    document.querySelectorAll('.answer').forEach(el=>{
      gsap.from(el,{x:-40,autoAlpha:0,duration:.8,scrollTrigger:{trigger:el,start:'top 86%',once:true}});
    });

    /* card run: phone + chat choreography */
    const chat=document.getElementById('chat');
    if(chat){
      const msgs=chat.querySelectorAll('.msg, .typing');
      gsap.set(msgs,{autoAlpha:0,y:16,scale:.96});
      gsap.timeline({scrollTrigger:{trigger:'.phone',start:'top 72%',once:true}})
        .from('.phone',{y:60,autoAlpha:0,rotation:2,duration:.8,ease:'back.out(1.2)'})
        .to(msgs[0],{autoAlpha:1,y:0,scale:1,duration:.4,ease:'back.out(1.6)'},'+=.2')
        .to(msgs[1],{autoAlpha:1,y:0,scale:1,duration:.4,ease:'back.out(1.6)'},'+=.5')
        .to(msgs[2],{autoAlpha:1,y:0,scale:1,duration:.4,ease:'back.out(1.6)'},'+=.6')
        .to(msgs[3],{autoAlpha:1,y:0,scale:1,duration:.3},'+=.4')
        .to(msgs[3],{autoAlpha:0,duration:.25,display:'none'},'+=1.1')
        .to(msgs[4],{autoAlpha:1,y:0,scale:1,duration:.45,ease:'back.out(1.5)'},'<+.1');
      gsap.from('.alive-points li',{x:-24,autoAlpha:0,stagger:.12,duration:.6,
        scrollTrigger:{trigger:'.alive-points',start:'top 85%',once:true}});
    }

    /* inside: doc stage + tab buttons */
    gsap.from('.doctab-btns label',{x:-30,autoAlpha:0,stagger:.1,duration:.6,
      scrollTrigger:{trigger:'.doctab-btns',start:'top 82%',once:true}});
    gsap.from('.docstage',{y:50,autoAlpha:0,rotation:1.5,duration:.8,ease:'back.out(1.2)',
      scrollTrigger:{trigger:'.docstage',start:'top 80%',once:true}});

    /* parts, bands, fit, ticket, faq */
    ScrollTrigger.batch('.parts .part',{start:'top 88%',once:true,
      onEnter:els=>gsap.from(els,{y:40,autoAlpha:0,scale:.94,stagger:.08,ease:'back.out(1.3)',duration:.6})});
    document.querySelectorAll('.ctaband').forEach(el=>{
      gsap.from(el,{y:24,autoAlpha:0,duration:.6,scrollTrigger:{trigger:el,start:'top 90%',once:true}});
    });
    gsap.from('.forwho .who',{y:40,autoAlpha:0,stagger:.12,scrollTrigger:{trigger:'.forwho',start:'top 84%',once:true}});
    gsap.from('.ticket',{rotation:-1.5,y:44,autoAlpha:0,duration:.8,ease:'back.out(1.2)',
      scrollTrigger:{trigger:'.ticket',start:'top 84%',once:true}});
    gsap.from('.faq details',{y:26,autoAlpha:0,stagger:.07,duration:.55,
      scrollTrigger:{trigger:'.faq',start:'top 84%',once:true}});

    /* pricing */
    gsap.timeline({scrollTrigger:{trigger:'.tiers',start:'top 80%',once:true}})
      .from('.tier',{y:52,autoAlpha:0,stagger:.13,duration:.75,ease:'back.out(1.25)'})
      .from('.tier .tab',{scale:0,transformOrigin:'50% 100%',ease:'back.out(2.2)',duration:.45},'-=.15')
      .from('.slots',{autoAlpha:0,y:6,duration:.4},'-=.1');

    /* final: bento pop + card peek */
    gsap.timeline({scrollTrigger:{trigger:'.final',start:'top 65%',once:true}})
      .from('.final .bento-wave',{y:24,autoAlpha:0,scale:.8,transformOrigin:'50% 90%',ease:'back.out(1.7)',duration:.6})
      .from('.final .bento-wave .c1, .final .bento-wave .c2, .final .bento-wave .c3',
        {y:26,autoAlpha:0,stagger:.12,ease:'back.out(1.8)',duration:.45},'-=.25')
      .from('.final h2',{y:18,autoAlpha:0,duration:.5},'-=.3')
      .from('.final .btn',{y:12,autoAlpha:0,duration:.4},'-=.25');

    /* pointer-only delights */
    if(matchMedia('(pointer:fine)').matches){
      /* doc tilt on hover */
      const stage=document.querySelector('.docstage');
      if(stage){
        gsap.set(stage,{transformPerspective:900});
        const rx=gsap.quickTo(stage,'rotationX',{duration:.5,ease:'power2.out'});
        const ry=gsap.quickTo(stage,'rotationY',{duration:.5,ease:'power2.out'});
        stage.addEventListener('mousemove',e=>{
          const r=stage.getBoundingClientRect();
          ry(gsap.utils.clamp(-6,6,((e.clientX-r.left)/r.width-.5)*10));
          rx(gsap.utils.clamp(-6,6,-((e.clientY-r.top)/r.height-.5)*10));
        });
        stage.addEventListener('mouseleave',()=>{rx(0);ry(0)});
      }
      /* magnetic hero CTA */
      const mag=document.querySelector('.hero-cta .btn:not(.ghost)');
      if(mag){
        const qx=gsap.quickTo(mag,'x',{duration:.35,ease:'power3'}),qy=gsap.quickTo(mag,'y',{duration:.35,ease:'power3'});
        mag.addEventListener('mousemove',e=>{
          const r=mag.getBoundingClientRect();
          qx(gsap.utils.clamp(-4,4,(e.clientX-r.left-r.width/2)*.08));
          qy(gsap.utils.clamp(-4,4,(e.clientY-r.top-r.height/2)*.15));
        });
        mag.addEventListener('mouseleave',()=>{gsap.to(mag,{x:0,y:0,duration:.45,ease:'elastic.out(1,.5)'})});
      }
    }
    return ()=>{};
  });
  mm.add('(prefers-reduced-motion: reduce)',()=>{
    document.querySelectorAll('.rv').forEach(el=>el.classList.add('in'));
    const chat=document.getElementById('chat');
    if(chat){const t=chat.querySelector('.typing');if(t)t.style.display='none'}
  });
})();
</script>
