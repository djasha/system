<script>
/* ---- theme toggle (init ran in <head>) ---- */
(function(){
  const btn=document.getElementById('themeBtn'),root=document.documentElement;
  sync();
  btn.addEventListener('click',()=>{
    const t=root.dataset.theme==='dark'?'light':'dark';
    root.dataset.theme=t;
    try{localStorage.setItem('akl-theme',t)}catch(e){}
    sync();
  });
  function sync(){
    const dark=root.dataset.theme==='dark';
    btn.textContent=dark?'☀️':'🌙';
    btn.setAttribute('aria-pressed',String(dark));
    btn.setAttribute('aria-label',dark?'Switch to light theme':'Switch to dark theme');
  }
})();

/* ---- scroll reveal (CSS fallback when GSAP absent) ---- */
(function(){
  if(matchMedia('(prefers-reduced-motion: reduce)').matches){
    document.querySelectorAll('.rv').forEach(el=>el.classList.add('in'));return;
  }
  if(window.gsap)return;
  const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
  document.querySelectorAll('.rv').forEach(el=>io.observe(el));
})();

/* ---- typewriter: single-owner, grapheme-safe, 2 passes then hold ---- */
(function(){
  const body=document.getElementById('termBody');
  const FULL='<span class="u">&gt; </span>vault status<br><span class="a">✓ member since 2026-07<br>✓ shelf: 4 kits · 60+ cards · 2 tools<br></span><span class="hl">drop 07: </span>returns rescue pack — live<br><br><span class="u">&gt; </span>vault next<br><span class="a">✓ next drop in 09 days<br>✓ kit nº 06 in the works — included</span>';
  if(matchMedia('(prefers-reduced-motion: reduce)').matches){body.innerHTML=FULL;return}
  const script=[
    {t:'> ',c:'u'},{t:'vault status\n',c:'',type:true},
    {t:'✓ member since 2026-07\n',c:'a',pause:400},
    {t:'✓ shelf: 4 kits · 60+ cards · 2 tools\n',c:'a',pause:300},
    {t:'drop 07: ',c:'hl',pause:500},{t:'returns rescue pack — live\n\n',c:'',type:true},
    {t:'> ',c:'u',pause:700},{t:'vault next\n',c:'',type:true},
    {t:'✓ next drop in 09 days\n',c:'a',pause:450},
    {t:'✓ kit nº 06 in the works — included\n',c:'a',pause:350},
  ];
  let runId=0,pass=0,timer=null,running=false;
  function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/\n/g,'<br>')}
  function cur(on){const c=body.querySelector('.cursor');if(c)c.remove();if(on)body.insertAdjacentHTML('beforeend','<span class="cursor"></span>')}
  function start(){
    if(running)return;running=true;
    const my=++runId;body.innerHTML='';let i=0;
    (function step(){
      if(my!==runId)return;
      if(i>=script.length){
        pass++;
        if(pass>=2){cur(true);running=false;return}
        timer=setTimeout(()=>{if(my===runId){running=false;start()}},6000);return;
      }
      const s=script[i++];
      timer=setTimeout(()=>{
        if(my!==runId)return;
        if(s.type){
          const chars=[...s.t];let j=0;
          (function ch(){
            if(my!==runId)return;
            cur(false);
            body.insertAdjacentHTML('beforeend',`<span class="${s.c}">${esc(chars[j])}</span>`);
            cur(true);
            if(++j<chars.length)timer=setTimeout(ch,34+((j*7)%40));else step();
          })();
        }else{
          cur(false);
          body.insertAdjacentHTML('beforeend',`<span class="${s.c}">${esc(s.t)}</span>`);
          cur(true);
          step();
        }
      },s.pause||60);
    })();
  }
  function stop(){runId++;clearTimeout(timer);running=false}
  document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();else if(pass<2)start()});
  window.__termStart=start;
  if(!window.gsap)start();
})();

/* ---- GSAP choreography ---- */
(function(){
  if(!window.gsap)return;
  gsap.registerPlugin(ScrollTrigger);
  const mm=gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)',()=>{
    gsap.defaults({duration:.7,ease:'power3.out'});
    const kill=document.createElement('style');
    kill.textContent='.js .rv{transition:none!important;opacity:1;transform:none}';
    document.head.appendChild(kill);
    document.querySelectorAll('.rv').forEach(el=>el.classList.add('in'));
    const tl=gsap.timeline();
    tl.from('.pill',{y:24,autoAlpha:0,scale:.85,ease:'back.out(1.6)'},.05)
      .from('.hero h1',{y:56,autoAlpha:0,duration:.9,ease:'expo.out'},.15)
      .from('.hero .lead',{y:30,autoAlpha:0},.38)
      .from('.hero-cta .btn',{y:22,autoAlpha:0,scale:.92,stagger:.09,ease:'back.out(1.5)'},.52)
      .from('.hero .micro span',{y:14,autoAlpha:0,stagger:.06,duration:.45},.68)
      .from('.term',{y:70,autoAlpha:0,duration:.9,ease:'expo.out'},.3)
      .from('.vaultmark',{y:-110,autoAlpha:0,duration:.85,ease:'bounce.out'},.75)
      .call(()=>window.__termStart&&window.__termStart(),null,1.1);
    document.querySelectorAll('.micro b').forEach(b=>{
      const n=parseInt(b.textContent,10);if(isNaN(n))return;
      const o={v:0};
      gsap.to(o,{v:n,duration:1.2,delay:.8,ease:'power2.out',onUpdate:()=>{b.textContent=Math.round(o.v)}});
    });
    document.querySelectorAll('.sec-num').forEach(el=>{
      gsap.fromTo(el,{yPercent:18},{yPercent:-14,ease:'none',
        scrollTrigger:{trigger:el.parentElement,start:'top bottom',end:'bottom top',scrub:1.2}});
    });
    document.querySelectorAll('section .sec-tag, section h2, section .sec-intro').forEach(el=>{
      gsap.from(el,{y:34,autoAlpha:0,duration:.75,scrollTrigger:{trigger:el,start:'top 88%',once:true}});
    });
    gsap.from('.duo .plat',{y:44,autoAlpha:0,rotation:i=>i?1.2:-1.2,stagger:.12,duration:.8,ease:'back.out(1.3)',
      scrollTrigger:{trigger:'.duo',start:'top 82%',once:true}});
    const pc=document.querySelector('.pipe-card');
    if(pc){
      gsap.timeline({scrollTrigger:{trigger:pc,start:'top 78%',once:true}})
        .from(pc,{y:50,autoAlpha:0,duration:.7,ease:'expo.out'})
        .from('.pipe rect',{scale:.6,autoAlpha:0,transformOrigin:'center',stagger:.14,ease:'back.out(1.8)',duration:.5},.25)
        .from('.pipe text, .pipe .nico',{autoAlpha:0,stagger:.025,duration:.3},.5)
        .from('.pipe .link',{autoAlpha:0,stagger:.12,duration:.4},.45)
        .from('.legend span',{y:12,autoAlpha:0,stagger:.07,duration:.4},'>-.2');
    }
    gsap.from('.tstep',{y:38,autoAlpha:0,stagger:.14,ease:'back.out(1.4)',
      scrollTrigger:{trigger:'.timeline',start:'top 82%',once:true}});
    document.querySelectorAll('.answer').forEach(el=>{
      gsap.from(el,{x:-40,autoAlpha:0,duration:.8,scrollTrigger:{trigger:el,start:'top 86%',once:true}});
    });
    const chat=document.getElementById('chat');
    if(chat){
      const msgs=chat.querySelectorAll('.msg, .typing');
      gsap.set(msgs,{autoAlpha:0,y:16,scale:.96});
      gsap.timeline({scrollTrigger:{trigger:'.phone',start:'top 72%',once:true}})
        .from('.phone',{y:60,autoAlpha:0,rotation:2,duration:.8,ease:'back.out(1.2)'})
        .to(msgs[0],{autoAlpha:1,y:0,scale:1,duration:.4,ease:'back.out(1.6)'},'+=.2')
        .to(msgs[1],{autoAlpha:1,y:0,scale:1,duration:.4,ease:'back.out(1.6)'},'+=.5')
